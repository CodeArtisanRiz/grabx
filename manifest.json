{
  "manifest_version": 3,
  "name": "GrabX",
  "version": "2.0.0",
  "description": "Extracts full site DNA — animations, design tokens, fonts, layout, assets — for AI-assisted cloning.",
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {
    "default_title": "GrabX — Activate & Record Site DNA"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
